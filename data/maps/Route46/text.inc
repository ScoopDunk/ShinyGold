Route46_Text_HikerBailey::
	.string "It’s over. I don’t mind. We HIKERS\n"
	.string "are like that.$"

Route46_Text_Trigger2::
	.string "It’s a fruit-bearing tree.\p"
	.string "Hey! It’s CHERI BERRY!$"
