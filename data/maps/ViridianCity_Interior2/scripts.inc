	setflag 0x030
	call ViridianCity_Interior2_EventScript_LeaderBlue2_2
	msgbox ViridianCity_Interior2_Text_LeaderBlue2_2, MSGBOX_NPC
	end

ViridianCity_Interior2_EventScript_LeaderBlue2_2::
