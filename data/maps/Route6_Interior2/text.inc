Route6_Interior2_Text_Policeman_1::
	.string "Welcome to SAFFRON CITY, home of\n"
	.string "the MAGNET TRAIN!\p"
	.string "...That’s what I’d normally say, but\n"
	.string "the MAGNET TRAIN isn’t running now.\p"
	.string "It’s not getting any electricity\n"
	.string "because there’s something wrong\l"
	.string "with the POWER PLANT.$"

Route6_Interior2_Text_Policeman_2::
	.string "The MAGNET TRAIN is the most famous\n"
	.string "thing about SAFFRON.$"

Route6_Interior2_Text_Trigger1_1::
	.string "I’m on guard duty.\n"
	.string "Gee, I’m thirsty, though!\p"
	.string "Oh, wait there, the road’s closed.$"

Route6_Interior2_Text_Trigger1_2::
	.string "Oh, that TEA…\n"
	.string "It looks awfully tasty…$"

Route6_Interior2_Text_Trigger1_3::
	.string "Huh? I can have this drink?\n"
	.string "Gee, thanks!\l"
	.string "… …\l"
	.string "Glug, glug…\l"
	.string "… …\l"
	.string "Gulp…\l"
	.string "If you want to go to SAFFRON\l"
	.string "CITY…\l"
	.string "… …\l"
	.string "You can go on through.\p"
	.string "I’ll share this TEA with the other\n"
	.string "guards!$"
