Route40_Text_CrushGirl::
	.string "Although you can’t see it from here,\n"
	.string "CIANWOOD is across the sea.$"

Route40_Text_SwimmerMSimonIntro::
	.string "You have to warm up before going\n"
	.string "into the water.\p"
	.string "That’s basic.$"

Route40_Text_SwimmerMSimonDefeat::
	.string "OK! Uncle! I give!$"

Route40_Text_SwimmerMSimon::
	.string "CIANWOOD CITY is a good distance\n"
	.string "away from here.$"

Route40_Text_SwimmerFElaineIntro::
	.string "Are you going to CIANWOOD?\n"
	.string "How about a quick battle first?$"

Route40_Text_SwimmerFElaineDefeat::
	.string "I lost that one!$"

Route40_Text_SwimmerFElaine::
	.string "I’d say I’m a better swimmer than\n"
	.string "you. Yeah!$"

Route40_Text_SwimmerFPaulaIntro::
	.string "No inner tube for me.\n"
	.string "I’m hanging on to a sea POKéMON!$"

Route40_Text_SwimmerFPaulaDefeat::
	.string "Ooh, I’m feeling dizzy!$"

Route40_Text_SwimmerFPaula::
	.string "While I float like this, the waves\n"
	.string "carry me along.$"

Route40_Text_SwimmerMRandallIntro::
	.string "A young guy like you should swim.\n"
	.string "Don’t SURF on your POKéMON.$"

Route40_Text_SwimmerMRandallDefeat::
	.string "Uh-oh. I lost...$"

Route40_Text_SwimmerMRandall::
	.string "Swimming exercises your entire body.\n"
	.string "It’s healthy.$"

Route40_Text_Sign::
	.string "ROUTE 40\n"
	.string "CIANWOOD CITY - OLIVINE CITY$"
