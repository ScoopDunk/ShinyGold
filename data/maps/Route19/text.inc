Route19_Text_Fisher_1::
	.string "Who knows how long it would take to\n"
	.string "move this boulder...$"

Route19_Text_Fisher_2::
	.string "The roadwork is finally finished.\n"
	.string "Now I can go fishing again.$"

Route19_Text_FatMan_1::
	.string "Sorry. This road is closed for\n"
	.string "construction.\p"
	.string "If you want to get to CINNABAR,\n"
	.string "you’d better go south from\l"
	.string "PALLET TOWN.$"

Route19_Text_FatMan_2::
	.string "I’m all sweaty.\n"
	.string "Time for a swim!$"

Route19_Text_SwimmerMJeromeIntro::
	.string "Swimming? I’m lousy at it.\n"
	.string "I’m just splashing around in these\l"
	.string "shallow waters.$"

Route19_Text_SwimmerMJeromeDefeat::
	.string "I thought I could win.$"

Route19_Text_SwimmerMJerome::
	.string "I might be bad at swimming,\n"
	.string "but I love the sea.$"

Route19_Text_SwimmerMHaroldIntro::
	.string "Have you ever gone swimming in the\n"
	.string "sea at night?$"

Route19_Text_SwimmerMHaroldDefeat::
	.string "Glub...$"

Route19_Text_SwimmerMHarold::
	.string "At night, the sea turns black.\n"
	.string "It feels like it will swallow you up.$"

Route19_Text_SwimmerMTuckerIntro::
	.string "Pant, pant... Just... A little...\n"
	.string "Farther... To... FUCHSIA...$"

Route19_Text_SwimmerMTuckerDefeat::
	.string "I’m drowning!$"

Route19_Text_SwimmerMTucker::
	.string "I... Asked my girlfriend to swim\n"
	.string "to FUCHSIA... Gasp...$"

Route19_Text_SwimmerFDawnIntro::
	.string "I’m disgusted by wimpy people!$"

Route19_Text_SwimmerFDawnDefeat::
	.string "I could beat you at swimming...$"

Route19_Text_SwimmerFDawn::
	.string "It’s a quick swim between FUCHSIA\n"
	.string "and SEAFOAM ISLANDS...\p"
	.string "Sheesh, some big man my boyfriend\n"
	.string "is! What a wimp!$"

Route19_Text_Sign1::
	.string "ROUTE 19\p"
	.string "{UP_ARROW} FUCHSIA CITY\n"
	.string "{DOWN_ARROW} SEAFOAM ISLANDS$"

Route19_Text_Sign2::
	.string "Please be careful if you are\n"
	.string "swimming to SEAFOAM ISLANDS.\p"
	.string "FUCHSIA POLICE$"
