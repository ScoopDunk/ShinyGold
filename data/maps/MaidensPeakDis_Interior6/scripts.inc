MaidensPeakDis_Interior6_OnLoad::
	call_if_unset 0x288, EventScript_Close9FDoor1
	call_if_unset 0x289, EventScript_Close9FDoor2
	call_if_unset 0x28A, EventScript_Close9FDoor3
	call_if_unset 0x28B, EventScript_Close9FDoor4
	end

