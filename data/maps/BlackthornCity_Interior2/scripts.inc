BlackthornCity_Interior2_MapScripts::
	.byte 0

BlackthornCity_Interior2_EventScript_FatMan::
	goto_if_questlog EventScript_ReleaseEnd
	special QuestLog_CutRecording
	lock
	faceplayer
	clearflag FLAG_TEMP_2
	clearflag FLAG_TEMP_3
	clearflag FLAG_TEMP_4
	goto_if_set FLAG_TEMP_1, BlackthornCity_Interior2_EventScript_FatMan_1
	msgbox BlackthornCity_Interior2_Text_FatMan_1
	setflag FLAG_TEMP_1
	goto BlackthornCity_Interior2_EventScript_FatMan_1

BlackthornCity_Interior2_EventScript_FatMan_1::
	checkitem ITEM_BIG_MUSHROOM
	call_if_eq VAR_RESULT, 1, BlackthornCity_Interior2_EventScript_FatMan_2
	checkitem ITEM_TINY_MUSHROOM, 2
	call_if_eq VAR_RESULT, 1, BlackthornCity_Interior2_EventScript_FatMan_3
	goto_if_set FLAG_TEMP_2, BlackthornCity_Interior2_EventScript_FatMan_4
	goto_if_set FLAG_TEMP_3, BlackthornCity_Interior2_EventScript_FatMan_5
	goto BlackthornCity_Interior2_EventScript_FatMan_6

BlackthornCity_Interior2_EventScript_FatMan_2::
	setflag FLAG_TEMP_2
	return

BlackthornCity_Interior2_EventScript_FatMan_3::
	setflag FLAG_TEMP_3
	return

BlackthornCity_Interior2_EventScript_FatMan_4::
	call_if_set FLAG_TEMP_3, BlackthornCity_Interior2_EventScript_FatMan_7
	goto BlackthornCity_Interior2_EventScript_FatMan_8

BlackthornCity_Interior2_EventScript_FatMan_5::
	call_if_set FLAG_TEMP_2, BlackthornCity_Interior2_EventScript_FatMan_7
	goto BlackthornCity_Interior2_EventScript_FatMan_8

BlackthornCity_Interior2_EventScript_FatMan_6::
	msgbox BlackthornCity_Interior2_Text_FatMan_2
	release
	end

BlackthornCity_Interior2_EventScript_FatMan_7::
	setflag FLAG_TEMP_4
	return

BlackthornCity_Interior2_EventScript_FatMan_8::
	msgbox BlackthornCity_Interior2_Text_FatMan_3, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, 0, BlackthornCity_Interior2_EventScript_FatMan_6
	goto BlackthornCity_Interior2_EventScript_FatMan_9

BlackthornCity_Interior2_EventScript_FatMan_9::
	msgbox BlackthornCity_Interior2_Text_FatMan_4
	special ChooseMonForMoveRelearner
	waitstate
	goto_if_ge VAR_0x8004, 6, BlackthornCity_Interior2_EventScript_FatMan_6
	special IsSelectedMonEgg
	goto_if_eq VAR_RESULT, 1, BlackthornCity_Interior2_EventScript_FatMan_10
	goto_if_eq VAR_0x8005, 0, BlackthornCity_Interior2_EventScript_FatMan_11
	goto BlackthornCity_Interior2_EventScript_FatMan_12

BlackthornCity_Interior2_EventScript_FatMan_10::
	msgbox BlackthornCity_Interior2_Text_FatMan_5
	goto BlackthornCity_Interior2_EventScript_FatMan_9

BlackthornCity_Interior2_EventScript_FatMan_11::
	msgbox BlackthornCity_Interior2_Text_FatMan_6
	goto BlackthornCity_Interior2_EventScript_FatMan_9

BlackthornCity_Interior2_EventScript_FatMan_12::
	msgbox BlackthornCity_Interior2_Text_FatMan_7
	special TeachMoveRelearnerMove
	waitstate
	goto_if_eq VAR_0x8004, 0, BlackthornCity_Interior2_EventScript_FatMan_9
	goto_if_set FLAG_TEMP_4, BlackthornCity_Interior2_EventScript_FatMan_13
	goto_if_set FLAG_TEMP_2, BlackthornCity_Interior2_EventScript_FatMan_14
	goto_if_set FLAG_TEMP_3, BlackthornCity_Interior2_EventScript_FatMan_15
	end

BlackthornCity_Interior2_EventScript_FatMan_13::
	message BlackthornCity_Interior2_Text_FatMan_8
	waitmessage
	multichoice 0, 0, MULTICHOICE_MUSHROOMS, 1
	switch VAR_RESULT
	case 0, BlackthornCity_Interior2_EventScript_FatMan_15
	case 1, BlackthornCity_Interior2_EventScript_FatMan_14
	end

BlackthornCity_Interior2_EventScript_FatMan_14::
	removeitem ITEM_BIG_MUSHROOM
	textcolor NPC_TEXT_COLOR_NEUTRAL
	msgbox BlackthornCity_Interior2_Text_FatMan_9
	call EventScript_RestorePrevTextColor
	goto BlackthornCity_Interior2_EventScript_FatMan_6

BlackthornCity_Interior2_EventScript_FatMan_15::
	removeitem ITEM_TINY_MUSHROOM, 2
	textcolor NPC_TEXT_COLOR_NEUTRAL
	msgbox BlackthornCity_Interior2_Text_FatMan_10
	call EventScript_RestorePrevTextColor
	goto BlackthornCity_Interior2_EventScript_FatMan_6

BlackthornCity_Interior2_EventScript_Sign::
	msgbox BlackthornCity_Interior2_Text_Sign, MSGBOX_SIGN
	end
