GoldenrodCity_Interior7_Text_Gentleman::
	.string "I’m the PRESIDENT.\p"
	.string "My dream was to build a train that\n"
	.string "is faster than any POKéMON.\p"
	.string "It really brings JOHTO much closer\n"
	.string "to KANTO.$"

GoldenrodCity_Interior7_Text_MgDeliveryman_1::
	.string "The train hasn’t come in...\p"
	.string "I know! I’ll carry the passengers on\n"
	.string "my back!\p"
	.string "That won’t work.$"

GoldenrodCity_Interior7_Text_MgDeliveryman_2::
	.string "We’ll soon depart for SAFFRON.\p"
	.string "Are you coming on board?$"

GoldenrodCity_Interior7_Text_MgDeliveryman_3::
	.string "We hope to see you again.$"

GoldenrodCity_Interior7_Text_MgDeliveryman_4::
	.string "Sorry, but you don’t have a PASS.$"

GoldenrodCity_Interior7_Text_MgDeliveryman_5::
	.string "May I see your rail PASS, please?\p"
	.string "OK. Right this way, sir.$"

GoldenrodCity_Interior7_Text_Trigger::
	.string "We have arrived in GOLDENROD.\p"
	.string "We hope to see you again.$"
