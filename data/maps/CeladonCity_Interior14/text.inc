CeladonCity_Interior14_Text_Chef::
	.string "Hi!\p"
	.string "We’re holding an eatathon contest.\p"
	.string "We can’t serve you right now. Sorry.$"

CeladonCity_Interior14_Text_FatMan_1::
	.string "...Snarfle, chew...$"

CeladonCity_Interior14_Text_FatMan_2::
	.string "Don’t talk to me!\p"
	.string "You’ll break my concentration!$"

CeladonCity_Interior14_Text_Woman3_1::
	.string "Crunch... Crunch...\p"
	.string "I can keep eating!$"

CeladonCity_Interior14_Text_Woman3_2::
	.string "More, CHEF!$"

CeladonCity_Interior14_Text_BaldingMan_1::
	.string "...Gulp... Chew...$"

CeladonCity_Interior14_Text_BaldingMan_2::
	.string "I take quantity over quality!\p"
	.string "I’m happy when I’m full!$"

CeladonCity_Interior14_Text_FatMan2_1::
	.string "Munch, munch...$"

CeladonCity_Interior14_Text_FatMan2_2::
	.string "The food is good here, but GOLDENROD\n"
	.string "has the best food anywhere.$"
